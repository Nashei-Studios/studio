--[[
	Turns a saved place (.rbxl) into something a person or an agent can read without Studio:
	every script as a .luau file under <out>/src, and an INVENTORY.md with what the place holds.
	Read-only for the place file.

	Usage (from any repo whose rokit.toml lists lune):
	  lune run <path to>/place-export.luau <place.rbxl> <out dir>
]]
local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local placePath, outDir = process.args[1], process.args[2]
if not placePath or not outDir then
	print("usage: lune run place-export.luau <place.rbxl> <out dir>")
	process.exit(2)
end

local game = roblox.deserializePlace(fs.readFile(placePath))

local function safe(name: string): string
	return (name:gsub('[<>:"/\\|%?%*]', "_"))
end

local function ensureDir(path: string)
	if not fs.isDir(path) then
		fs.writeDir(path)
	end
end

local SUFFIX = { Script = ".server.luau", LocalScript = ".client.luau", ModuleScript = ".luau" }

local classCount: { [string]: number } = {}
local services = {}
local scripts = {}
local used: { [string]: boolean } = {}

for _, service in game:GetChildren() do
	local descendants = service:GetDescendants()
	if #descendants > 0 then
		table.insert(services, { name = service.Name, n = #descendants })
	end
	for _, inst in descendants do
		classCount[inst.ClassName] = (classCount[inst.ClassName] or 0) + 1
		local suffix = SUFFIX[inst.ClassName]
		if suffix then
			local ok, source = pcall(function()
				return (inst :: any).Source
			end)
			if ok and typeof(source) == "string" then
				local parts = {}
				local node: any = inst
				while node and node ~= game do
					table.insert(parts, 1, safe(node.Name))
					node = node.Parent
				end
				local rel = table.concat(parts, "/")
				-- Two siblings can share a name; keep both.
				local candidate, i = rel, 1
				while used[candidate .. suffix] do
					i += 1
					candidate = rel .. "_" .. i
				end
				used[candidate .. suffix] = true
				local lines = select(2, source:gsub("\n", "\n")) + 1
				table.insert(scripts, { path = candidate .. suffix, class = inst.ClassName, lines = lines, source = source })
			end
		end
	end
end

ensureDir(outDir)
local srcDir = outDir .. "/src"
ensureDir(srcDir)
for _, s in scripts do
	local dir = srcDir
	local segments = s.path:split("/")
	for i = 1, #segments - 1 do
		dir ..= "/" .. segments[i]
		ensureDir(dir)
	end
	fs.writeFile(srcDir .. "/" .. s.path, s.source)
end

table.sort(services, function(a, b)
	return a.n > b.n
end)
table.sort(scripts, function(a, b)
	return a.lines > b.lines
end)
local classes = {}
for name, n in classCount do
	table.insert(classes, { name = name, n = n })
end
table.sort(classes, function(a, b)
	return a.n > b.n
end)

local total, totalLines = 0, 0
for _, s in services do
	total += s.n
end
for _, s in scripts do
	totalLines += s.lines
end

local out = {
	"# Inventory",
	"",
	("Generated by `tools/place-export.luau` of `Nashei-Studios/studio`. %d instances, %d scripts, %d lines."):format(
		total,
		#scripts,
		totalLines
	),
	"",
	"## Instances per service",
	"",
	"| Service | Instances |",
	"|---|---|",
}
for _, s in services do
	table.insert(out, ("| %s | %d |"):format(s.name, s.n))
end
table.insert(out, "")
table.insert(out, "## Most common classes")
table.insert(out, "")
table.insert(out, "| Class | Count |")
table.insert(out, "|---|---|")
for i = 1, math.min(20, #classes) do
	table.insert(out, ("| %s | %d |"):format(classes[i].name, classes[i].n))
end
table.insert(out, "")
table.insert(out, "## Scripts")
table.insert(out, "")
table.insert(out, "| Lines | Kind | File |")
table.insert(out, "|---|---|---|")
for _, s in scripts do
	table.insert(out, ("| %d | %s | `src/%s` |"):format(s.lines, s.class, s.path))
end
table.insert(out, "")
fs.writeFile(outDir .. "/INVENTORY.md", table.concat(out, "\n"))
print(("exported %d scripts (%d lines) to %s"):format(#scripts, totalLines, outDir))
