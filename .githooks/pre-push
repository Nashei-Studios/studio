#!/bin/sh
# Local guard for the permanent branches (ADR 0066). A private repo on the Free plan has no
# server-side branch rules, so this hook stops the destructive pushes before they leave the machine:
#   - any direct push to main (main only moves through the release PR or a hotfix PR)
#   - deleting main or develop
#   - rewriting history on main or develop (non fast-forward)
# Enabled by scripts/bootstrap.ps1 with: git config core.hooksPath .githooks
# Emergency override, stated out loud to the team first: ALLOW_PROTECTED_PUSH=1 git push ...
[ "$ALLOW_PROTECTED_PUSH" = "1" ] && exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/develop) ;;
    *) continue ;;
  esac
  branch=${remote_ref#refs/heads/}
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete '$branch'." >&2
    status=1
    continue
  fi
  if [ "$branch" = "main" ]; then
    echo "pre-push: refusing a direct push to 'main'. Open a PR (release or hotfix)." >&2
    status=1
    continue
  fi
  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing to rewrite history on '$branch' (non fast-forward)." >&2
    status=1
  fi
done
exit $status
