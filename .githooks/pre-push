#!/bin/sh
# Local guard for the permanent branches (ADR 0066, issue 108). A private repo on the Free plan has no
# server-side branch rules, so this hook stops the pushes that skip a PR before they leave the machine:
#   - any direct push to main (main only moves through the release PR or a hotfix PR)
#   - any direct push to develop (develop only moves through a merged PR)
#   - deleting main or develop
# Git hands this hook the refs a push really updates, however the command was written (an alias, a script,
# bash -c, a refspec, remote.<name>.push, --all), so the rule lives here; the agent's shell guard only answers
# earlier with the branch command.
# Enabled by scripts/bootstrap.ps1 and puesto.ps1 install with: git config core.hooksPath .githooks
# Emergency override, stated out loud to the team first: ALLOW_PROTECTED_PUSH=1 git push ...
[ "$ALLOW_PROTECTED_PUSH" = "1" ] && exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/develop) ;;
    *) continue ;;
  esac
  branch=${remote_ref#refs/heads/}
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete '$branch'." >&2
    status=1
    continue
  fi
  if [ "$branch" = "main" ]; then
    echo "pre-push: refusing a direct push to 'main'. Open a PR (release or hotfix)." >&2
  else
    echo "pre-push: refusing a direct push to '$branch'. Push your work branch and open a PR: git push -u origin HEAD" >&2
  fi
  status=1
done
exit $status
